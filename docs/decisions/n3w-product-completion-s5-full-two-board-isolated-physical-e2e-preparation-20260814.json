  "blocking_findings": [
    {
      "id": "S5-PREP-B01",
      "finding": "The board integration requires an externally supplied ProductS5ManagerPort for Relay S5 authorization, but the frozen implementation contains no concrete board transport that supplies Manager-aligned authority time, publishes the existing S4 peer-authorization request, receives the Manager response, and returns both grants to the coordinator.",
      "impact": "A private package created now could boot the compiled S5 runtime but could not complete the required physical Manager grant path without adding unbound ad-hoc live code."
    },
    {
      "id": "S5-PREP-B02",
      "finding": "N3wProductIsolatedManager is deliberately non-live and opens no socket or MQTT client. The frozen Relay telemetry bridge accepts an external RelayForwardSink, but no concrete isolated physical Relay-to-Manager transport is bound in the public S5 board assembly.",
      "impact": "Child-to-Relay reliable ESP-NOW can be compiled, but the required Relay-to-isolated-Manager physical telemetry hop is not yet a reproducible product path."
    }
  ],
  "required_successor_repair": {
    "scope": "HOST_COMPILE_ONLY_NO_LIVE_EXECUTION",
    "requirements": [
      "add an opt-in isolated Relay Manager transport using the existing S4 authorization topics and request/response schema",
      "supply Manager-aligned epoch time without treating endpoint monotonic uptime as Unix epoch",
      "deliver decoded child_grant and relay_grant to the existing ProductS5PeerCoordinator",
      "add an opt-in RelayForwardSink that forwards the existing gh.relay/1 frame to the existing isolated Manager ingress topic without defining a second telemetry schema",
      "keep normal production Manager startup and public board profiles unchanged and inert",
      "compile the exact ESP32-C6 Relay target with the transport present but disabled by default",
      "prove host-side topic/schema/grant/telemetry compatibility with existing S4 and S5-C authorities",
      "perform no board, RF, Wi-Fi, MQTT-network, T1, or production execution"
    ]
  },
