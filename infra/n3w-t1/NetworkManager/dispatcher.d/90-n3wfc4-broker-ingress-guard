#!/bin/sh
set -eu

interface="${1:-}"
action="${2:-}"

[ "$interface" = "eth0" ] || exit 0

case "$action" in
    pre-up|up|dhcp4-change|reapply|pre-down|down)
        ;;
    *)
        exit 0
        ;;
esac

/usr/bin/systemctl --quiet is-active docker.service || exit 0

if /usr/bin/timeout 20s /usr/bin/systemctl reload-or-restart n3wfc4-broker-ingress-guard.service; then
    if /usr/bin/timeout 30s /usr/bin/systemctl start n3wfc4-broker-activation.service; then
        exit 0
    fi
fi

/usr/bin/timeout 30s /usr/bin/systemctl stop n3wfc4-broker-activation.service || true
exit 1
