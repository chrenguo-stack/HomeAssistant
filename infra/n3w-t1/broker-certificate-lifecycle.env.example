N3WFC4_CERT_SERVER_CERT_FILE=/etc/n3wfc4/tls/server.pem
N3WFC4_CERT_SERVER_KEY_FILE=/etc/n3wfc4/tls/server.key
N3WFC4_CERT_CA_CERT_FILE=/etc/n3wfc4/tls/ca.pem
N3WFC4_CERT_CA_KEY_FILE=/opt/greenhouse-secrets/broker-ca/ca.key
N3WFC4_CERT_SYSTEM_CA_FILE=/var/lib/greenhouse-manager/identity/system-ca.pem
N3WFC4_CERT_SERVER_NAME=armbian
N3WFC4_CERT_STATUS_FILE=/var/lib/n3wfc4-certificate-lifecycle/status.json
N3WFC4_CERT_ALLOWED_ROOT_FC4=/etc/n3wfc4
N3WFC4_CERT_ALLOWED_ROOT_SECRET=/opt/greenhouse-secrets/broker-ca
N3WFC4_CERT_ALLOWED_ROOT_SYSTEM=/var/lib/greenhouse-manager/identity
