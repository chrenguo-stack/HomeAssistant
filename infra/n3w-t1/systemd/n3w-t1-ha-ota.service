[Unit]
Description=N3-W T1 Home Assistant mandatory-USB OTA host daemon
Requires=docker.service
After=docker.service

[Service]
Type=simple
User=root
Group=999
UMask=0007
RuntimeDirectory=n3w-t1-ota
RuntimeDirectoryMode=0750
ExecStartPre=/usr/bin/test ! -L /run/n3w-t1-ota-ipc
ExecStartPre=/usr/bin/install -d -o root -g 999 -m 0750 /run/n3w-t1-ota-ipc
ExecStart=/usr/bin/python3 /opt/HomeAssistant/tools/n3w_t1_core_updater_ha_daemon.py
ExecStopPost=/usr/bin/find /run/n3w-t1-ota-ipc -maxdepth 1 -name ha-ota.sock -type s -user root -delete
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
