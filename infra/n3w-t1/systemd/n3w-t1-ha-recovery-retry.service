[Unit]
Description=Retry pending N3-W Home Assistant OTA recovery
After=docker.service n3wfc4-services-activation.service n3w-t1-ha-recovery-startup.service
ConditionPathExists=/var/lib/n3w-t1-core-updater/homeassistant-usb-upgrade.json

[Service]
Type=oneshot
PrivateMounts=yes
ExecStart=/usr/bin/python3 -I /opt/n3w-t1-core-updater/ha-recovery.pyz --resume-pending
TimeoutStartSec=45min
