[Unit]
Description=N3-W restore previous Home Assistant runtime before OTA cutover
After=docker.service n3wfc4-services-activation.service
Requires=docker.service
ConditionPathExists=/var/lib/n3w-t1-core-updater/homeassistant-usb-upgrade.json

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/HomeAssistant/tools/n3w_t1_core_updater_ha_recovery_startup.py
TimeoutStartSec=10min

[Install]
WantedBy=multi-user.target
