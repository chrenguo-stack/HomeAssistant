[Unit]
Description=N3-W resume Home Assistant OTA recovery
After=docker.service n3wfc4-services-activation.service
Requires=docker.service
ConditionPathExists=/var/lib/n3w-t1-core-updater/homeassistant-usb-upgrade.json

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /opt/n3w-t1-core-updater/ha-recovery.pyz
TimeoutStartSec=10min

[Install]
WantedBy=multi-user.target
