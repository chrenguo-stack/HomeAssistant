[Unit]
Description=N3W FC4 Broker guarded activation
Requires=docker.service n3wfc4-broker-ingress-guard.service
After=docker.service n3wfc4-broker-ingress-guard.service
PartOf=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/n3wfc4/broker-activation.env
ExecStart=/usr/bin/docker compose --env-file ${N3WFC4_COMPOSE_ENV_FILE} -f ${N3WFC4_COMPOSE_FILE} up -d --no-deps broker
ExecStop=/usr/bin/docker compose --env-file ${N3WFC4_COMPOSE_ENV_FILE} -f ${N3WFC4_COMPOSE_FILE} stop broker
RemainAfterExit=yes
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=docker.service
