[Unit]
Description=N3W FC4 device provisioning resume/verify helper
Requires=docker.service
After=docker.service
Before=n3wfc4-broker-activation.service n3wfc4-services-activation.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/n3w-t1-provision resume-if-needed
RemainAfterExit=yes
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
