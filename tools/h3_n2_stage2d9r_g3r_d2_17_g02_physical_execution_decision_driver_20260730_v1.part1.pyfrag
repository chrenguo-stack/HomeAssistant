class DecisionError(RuntimeError):
    pass


def require(condition: bool, code: str) -> None:
    if not condition:
        raise DecisionError(code)


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def canonical_sha256(value: object) -> str:
    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8")).hexdigest()


def mode(path: Path) -> str:
    return format(stat.S_IMODE(path.stat().st_mode), "04o")


def exclusive_json(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(path.parent, 0o700)
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    fd = os.open(path, flags, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8", closefd=False) as handle:
            json.dump(value, handle, sort_keys=True, indent=2)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
    finally:
        os.close(fd)


def replace_json(path: Path, value: object) -> None:
    tmp = path.with_name(path.name + ".tmp")
    if tmp.exists():
        tmp.unlink()
    exclusive_json(tmp, value)
    os.replace(tmp, path)


def load_json(path: Path, code: str) -> dict[str, Any]:
    require(path.is_file() and not path.is_symlink(), code)
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
        raise DecisionError(code) from exc
    require(isinstance(value, dict), code)
    return value


def verify_root_sums(root: Path) -> None:
    sums = root / "SHA256SUMS"
    require(sums.is_file() and not sums.is_symlink(), "G02_ROOT_SHA256SUMS_MISSING")
    require(sha256_file(sums) == G02_ROOT_MANIFEST_SHA256, "G02_ROOT_SHA256SUMS_DIGEST_DRIFT")
    expected: dict[str, str] = {}
    for raw in sums.read_text(encoding="utf-8").splitlines():
        digest, name = raw.split("  ", 1)
        rel = Path(name)
        require(name not in expected and not rel.is_absolute() and ".." not in rel.parts, "G02_ROOT_SHA256SUMS_INVALID")
        expected[name] = digest
    observed = {
        path.relative_to(root).as_posix()
        for path in root.rglob("*")
        if path.is_file() and not path.is_symlink() and path != sums
    }
    require(set(expected) == observed, "G02_ROOT_SHA256SUMS_COVERAGE_DRIFT")
    for name, digest in expected.items():
        require(sha256_file(root / name) == digest, "G02_MEMBER_DIGEST_DRIFT:" + name)
    require(not any(path.is_symlink() for path in root.rglob("*")), "G02_SYMLINK_FORBIDDEN")


def resolved_targets() -> dict[str, Path]:
    result: dict[str, Path] = {}
    for name, (raw, expected) in TARGETS.items():
        path = Path(raw).expanduser().resolve(strict=True)
        require(path.is_file() and not path.is_symlink() and os.access(path, os.X_OK), "TARGET_TOOL_INVALID:" + name)
        require(sha256_file(path) == expected, "TARGET_TOOL_DIGEST_DRIFT:" + name)
        result[name] = path
    return result


def execution_environment(execution_root: Path, python_path: Path) -> dict[str, str]:
    root = execution_root.resolve(strict=True).as_posix()
    env = dict(os.environ)
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    env["GH_D2_17_DELIVERY_PROFILE"] = "private-package"
    env["GH_D2_13_LAUNCHER_PACKAGE_ROOT"] = root
    env["GH_D2_14_LAUNCHER_PACKAGE_ROOT"] = root
    env["GH_D2_15_LAUNCHER_PACKAGE_ROOT"] = root
    env["GH_D2_16_LAUNCHER_PACKAGE_ROOT"] = root
    env["PATH"] = str(python_path.parent) + os.pathsep + env.get("PATH", "")
    return env


def validate_host_only_evidence(package_root: Path, runtime_root: Path, targets: dict[str, Path]) -> tuple[dict[str, Any], dict[str, Any]]:
    verify_root_sums(package_root)
    terminal_path = runtime_root / "D2_17_TARGET_MAC_STATIC_CHECK_TERMINAL.json"
    auth_path = runtime_root / "D2_17_AUTHORIZATION.json"
    identity_path = runtime_root / "D2_17_EXECUTION_IDENTITY.json"
    static_path = runtime_root / "D2_17_TARGET_MAC_STATIC_CHECK.json"
    idempotency_path = runtime_root / "D2_17_BIND_INSTALL_IDEMPOTENCY.json"
    sentinel_path = runtime_root / "D2_17_HARDWARE_SENTINEL_SELF_CHECK.json"
    for path, digest, code in (
        (terminal_path, TERMINAL_FILE_SHA256, "TERMINAL_FILE_DIGEST_DRIFT"),
        (auth_path, AUTHORIZATION_FILE_SHA256, "AUTHORIZATION_FILE_DIGEST_DRIFT"),
        (static_path, STATIC_CHECK_FILE_SHA256, "STATIC_CHECK_FILE_DIGEST_DRIFT"),
        (idempotency_path, IDEMPOTENCY_FILE_SHA256, "IDEMPOTENCY_FILE_DIGEST_DRIFT"),
        (sentinel_path, SENTINEL_FILE_SHA256, "SENTINEL_FILE_DIGEST_DRIFT"),
    ):
        require(path.is_file() and not path.is_symlink() and sha256_file(path) == digest, code)
    terminal = load_json(terminal_path, "TERMINAL_RECORD_INVALID")
    require(terminal.get("status") == "PASS", "TERMINAL_STATUS_NOT_PASS")
    require(terminal.get("terminal_state") == "TARGET_MAC_STATIC_CHECK_PASSED_AUTHORIZATION_UNCLAIMED_UNCONSUMED", "TERMINAL_STATE_DRIFT")
    require(terminal.get("authorization_created") is True and terminal.get("authorization_claimed") is False and terminal.get("authorization_consumed") is False, "TERMINAL_AUTHORIZATION_STATE_DRIFT")
    require(terminal.get("physical_decision_created") is False, "TERMINAL_PHYSICAL_DECISION_ALREADY_CREATED")
    require(terminal.get("authorization_record_sha256") == AUTHORIZATION_RECORD_SHA256, "TERMINAL_AUTHORIZATION_BINDING_DRIFT")
