    identity=load_json(runtime/"D2_17_G11_EXECUTION_IDENTITY.json","EXECUTION_IDENTITY_INVALID");verify_binding(identity,"execution_identity_sha256",EXECUTION_IDENTITY_SHA256,"EXECUTION_IDENTITY")
    auth_path=runtime/"authorization/D2_17_G11_AUTHORIZATION.json";require(sha(auth_path)==AUTHORIZATION_FILE_SHA256,"AUTHORIZATION_FILE_DIGEST_DRIFT");auth=load_json(auth_path,"AUTHORIZATION_INVALID");verify_binding(auth,"authorization_record_sha256",AUTHORIZATION_RECORD_SHA256,"AUTHORIZATION")
    configured=load_json(runtime/"D2_17_G11_CONFIGURED_RUNTIME_VALIDATOR_EVIDENCE.json","CONFIGURED_EVIDENCE_INVALID");verify_binding(configured,"configured_runtime_validator_check_sha256",CONFIGURED_VALIDATOR_CHECK_SHA256,"CONFIGURED_EVIDENCE")
    common={"status":"PASS","authorization_claimed":False,"authorization_consumed":False,"physical_decision_created":False}
    for value,prefix in ((terminal,"STATIC_TERMINAL"),(summary,"STATIC_SUMMARY")):
        for k,e in common.items():require(value.get(k)==e,prefix+"_FIELD_DRIFT:"+k)
    require(terminal.get("terminal_state")=="TARGET_MAC_STATIC_CHECK_PASSED_AUTHORIZATION_UNCLAIMED_UNCONSUMED","STATIC_TERMINAL_STATE_DRIFT")
    require(summary.get("package_generation")=="G11" and summary.get("source_pr")==240 and summary.get("source_head_sha")=="b82c6c49729eabece02865e0c120b24ef6112511","STATIC_SOURCE_DRIFT")
    require(summary.get("private_delivery_binding_sha256")==PRIVATE_DELIVERY_BINDING_SHA256,"PRIVATE_DELIVERY_BINDING_DRIFT")
    require(summary.get("g10_expired_disposition_binding_sha256")==G10_EXPIRED_DISPOSITION_BINDING_SHA256 and summary.get("g11_pending_binding_sha256")==G11_PENDING_BINDING_SHA256,"SUCCESSOR_LINEAGE_DRIFT")
    require(summary.get("all_physical_operation_flags_false") is True and summary.get("hardware_sentinels_all_zero") is True,"STATIC_PHYSICAL_BOUNDARY_DRIFT")
    require(auth.get("board_identity_sha256")==BOARD_IDENTITY_SHA256 and auth.get("serial_identity_sha256")==SERIAL_IDENTITY_SHA256 and auth.get("baseline_state_sha256")==BASELINE_STATE_SHA256,"AUTHORIZED_PHYSICAL_IDENTITY_DRIFT")
    require(auth.get("expires_at")==AUTHORIZATION_EXPIRES_AT,"AUTHORIZATION_EXPIRY_DRIFT");require(datetime.now(timezone.utc)<=datetime.fromisoformat(AUTHORIZATION_EXPIRES_AT.replace("Z","+00:00")),"AUTHORIZATION_EXPIRED")
    state=runtime/"authorization-state-g11";require(state.is_dir() and not state.is_symlink(),"AUTHORIZATION_STATE_ROOT_INVALID");require((state/"G11_AUTHORIZATION_CREATED.json").is_file(),"AUTHORIZATION_CREATION_MARKER_MISSING");require(not (state/AUTH_MARKER_NAME).exists(),"AUTHORIZATION_ALREADY_CLAIMED_OR_CONSUMED")
    execution=(runtime/"artifact-execution/d2-17-execution-identity-frozen-physical-d2-execution-package").resolve(strict=True);request=(runtime/"artifact-execution/PHYSICAL_D2_REQUEST_17.json").resolve(strict=True)
    identity_adapter=(runtime/"artifact-identity_adapter/source/tools"/IDENTITY_ADAPTER_NAME).resolve(strict=True);outer_repair=(runtime/"artifact-outer_repair/source/tools"/OUTER_REPAIR_NAME).resolve(strict=True);marker_adapter=(runtime/"artifact-marker_repair/source/tools"/MARKER_REPAIR_NAME).resolve(strict=True)
    for p in (execution,request,identity_adapter,outer_repair,marker_adapter):require(p.exists() and not p.is_symlink(),"STATIC_RUNTIME_MEMBER_MISSING:"+p.name)
    os.environ.update(execution_env(execution,targets["python"]));sys.path.insert(0,str(execution));sys.path.insert(0,str(identity_adapter.parent));sys.path.insert(0,str(outer_repair.parent));sys.path.insert(0,str(marker_adapter.parent))
    wrapper=importlib.import_module(WRAPPER);contract=importlib.import_module(CONTRACT);identity_mod=importlib.import_module(IDENTITY_ADAPTER_NAME[:-3]);outer_mod=importlib.import_module(OUTER_REPAIR_NAME[:-3]);marker_mod=importlib.import_module(MARKER_REPAIR_NAME[:-3])
    req=contract.load_json(request,"PHYSICAL_REQUEST_INVALID");req=contract.validate_physical_request(req,execution);wrapper.bind_complete_chain();d2_11=wrapper._bound_d2_11()
    outer=outer_mod.validate_outer_preclaim_without_unbound_configure(d2_11=d2_11,d2_17_contract=contract,authorization_path=auth_path,authorization=auth,request=req,identity=identity,package_root=execution,python_path=targets["python"],openssl_path=targets["openssl"],esptool_path=targets["esptool"],mosquitto_path=targets["mosquitto"],now=datetime.now(timezone.utc),home=Path.home())
    require(outer.get("status")=="PASS" and outer.get("configured_core_called") is False,"OUTER_PRECLAIM_VALIDATION_FAILED")
    d2_11._BOUND_PHYSICAL_REQUEST=req
    first=identity_mod.install_runtime_identity_adapter(d2_11,contract,identity);second=marker_mod.install_runtime_marker_digest_adapter(d2_11,D2_REQUEST_ID)
    require(first.get("installed") and second.get("installed"),"RUNTIME_ADAPTER_INSTALL_FAILED")
    return {"runtime":runtime,"terminal":terminal,"summary":summary,"identity":identity,"authorization":auth,"authorization_path":auth_path,"state_root":state,"execution":execution,"request_path":request,"identity_adapter":identity_adapter,"marker_adapter":marker_adapter,"wrapper":wrapper,"contract":contract,"d2_11":d2_11}

def failure(code:str,flags:dict[str,bool])->dict[str,Any]:
    v={"schema":"gh.h3.n2.stage2d9r-g3r-d2-17-g11-physical-decision-terminal/1","status":"BLOCKED_BEFORE_INHERITED_CLAIM","terminal_state":"PHYSICAL_DECISION_PRECLAIM_BLOCKED_UNCLAIMED_UNCONSUMED","failure_code":code,"decision_id":DECISION_ID,"d2_request_id":D2_REQUEST_ID,"authorization_claimed":False,"authorization_consumed":False,"replay_permitted":False,"automatic_retry_permitted":False,"board_operation":flags["board"],"usb_enumeration":flags["usb"],"serial_operation":flags["serial"],"esptool_operation":flags["esptool"],"flash_operation":False,"physical_nvs_operation":flags["nvs"],"network_operation":False,"broker_started":False,"prepare_executed":False,"verify_executed":False,"recovery_executed":False,"activate_executed":False,"cleanup_executed":False,"ready":False,"merge":False,"release":False,"tag":False,"deployment":False};v["terminal_record_sha256"]=canonical(v);return v

