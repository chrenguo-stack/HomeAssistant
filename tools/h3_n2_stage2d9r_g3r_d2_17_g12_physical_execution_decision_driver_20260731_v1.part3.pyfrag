    terminal=load_json(runtime/"D2_17_G12_TARGET_MAC_STATIC_CHECK_TERMINAL.json","STATIC_TERMINAL_INVALID");verify_binding(terminal,"terminal_record_sha256",STATIC_TERMINAL_RECORD_SHA256,"STATIC_TERMINAL")
    summary=load_json(runtime/"D2_17_G12_PUBLIC_STATIC_CHECK_EXPORT_SUMMARY.json","STATIC_SUMMARY_INVALID");verify_binding(summary,"export_summary_sha256",STATIC_EXPORT_SUMMARY_SHA256,"STATIC_SUMMARY")
    identity=load_json(runtime/"D2_17_G12_EXECUTION_IDENTITY.json","EXECUTION_IDENTITY_INVALID");verify_binding(identity,"execution_identity_sha256",EXECUTION_IDENTITY_SHA256,"EXECUTION_IDENTITY")
    auth_path=runtime/"authorization/D2_17_G12_AUTHORIZATION.json";require(sha(auth_path)==AUTHORIZATION_FILE_SHA256,"AUTHORIZATION_FILE_DIGEST_DRIFT");auth=load_json(auth_path,"AUTHORIZATION_INVALID");verify_binding(auth,"authorization_record_sha256",AUTHORIZATION_RECORD_SHA256,"AUTHORIZATION")
    configured=load_json(runtime/"D2_17_G12_CONFIGURED_RUNTIME_VALIDATOR_EVIDENCE.json","CONFIGURED_EVIDENCE_INVALID");verify_binding(configured,"configured_runtime_validator_check_sha256",CONFIGURED_VALIDATOR_CHECK_SHA256,"CONFIGURED_EVIDENCE")
    common={"status":"PASS","authorization_claimed":False,"authorization_consumed":False,"physical_decision_created":False}
    for value,prefix in ((terminal,"STATIC_TERMINAL"),(summary,"STATIC_SUMMARY")):
        for k,e in common.items():require(value.get(k)==e,prefix+"_FIELD_DRIFT:"+k)
    require(terminal.get("terminal_state")=="TARGET_MAC_STATIC_CHECK_PASSED_AUTHORIZATION_UNCLAIMED_UNCONSUMED","STATIC_TERMINAL_STATE_DRIFT")
    require(summary.get("package_generation")=="G12" and summary.get("source_pr")==245 and summary.get("source_head_sha")=="759fc3d35cec6bbdf49d149c1422683645c3da6e","STATIC_SOURCE_DRIFT")
    require(summary.get("private_delivery_binding_sha256")==PRIVATE_DELIVERY_BINDING_SHA256,"PRIVATE_DELIVERY_BINDING_DRIFT")
    require(summary.get("g11_disposition_binding_sha256")==G11_DISPOSITION_BINDING_SHA256 and summary.get("g11_forensic_acceptance_binding_sha256")==G11_FORENSIC_ACCEPTANCE_BINDING_SHA256 and summary.get("g12_pending_binding_sha256")==G12_REPAIR_LINEAGE_BINDING_SHA256,"SUCCESSOR_LINEAGE_DRIFT")
    require(summary.get("g12_baseline_directory_repair_validated") is True and summary.get("g12_inherited_error_subcode_preservation_validated") is True,"G12_REPAIR_STATIC_VALIDATION_DRIFT")
    require(summary.get("all_physical_operation_flags_false") is True and summary.get("hardware_sentinels_all_zero") is True,"STATIC_PHYSICAL_BOUNDARY_DRIFT")
    require(auth.get("board_identity_sha256")==BOARD_IDENTITY_SHA256 and auth.get("serial_identity_sha256")==SERIAL_IDENTITY_SHA256 and auth.get("baseline_state_sha256")==BASELINE_STATE_SHA256,"AUTHORIZED_PHYSICAL_IDENTITY_DRIFT")
    require(auth.get("expires_at")==AUTHORIZATION_EXPIRES_AT,"AUTHORIZATION_EXPIRY_DRIFT");require(datetime.now(timezone.utc)<=datetime.fromisoformat(AUTHORIZATION_EXPIRES_AT.replace("Z","+00:00")),"AUTHORIZATION_EXPIRED")
    state=runtime/"authorization-state-g12";require(state.is_dir() and not state.is_symlink(),"AUTHORIZATION_STATE_ROOT_INVALID");require((state/"G12_AUTHORIZATION_CREATED.json").is_file(),"AUTHORIZATION_CREATION_MARKER_MISSING");require(not (state/AUTH_MARKER_NAME).exists(),"AUTHORIZATION_ALREADY_CLAIMED_OR_CONSUMED")
    execution=(runtime/"artifact-execution/d2-17-execution-identity-frozen-physical-d2-execution-package").resolve(strict=True);request=(runtime/"artifact-execution/PHYSICAL_D2_REQUEST_17.json").resolve(strict=True)
    identity_adapter=(runtime/"artifact-identity_adapter/source/tools"/IDENTITY_ADAPTER_NAME).resolve(strict=True);outer_repair=(runtime/"artifact-outer_repair/source/tools"/OUTER_REPAIR_NAME).resolve(strict=True);marker_adapter=(runtime/"artifact-marker_repair/source/tools"/MARKER_REPAIR_NAME).resolve(strict=True);g12_repair=(runtime/"artifact-g12_repair/source/tools"/G12_REPAIR_NAME).resolve(strict=True)
    for p in (execution,request,identity_adapter,outer_repair,marker_adapter,g12_repair):require(p.exists() and not p.is_symlink(),"STATIC_RUNTIME_MEMBER_MISSING:"+p.name)
