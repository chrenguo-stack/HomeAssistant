    os.environ.update(execution_env(execution,targets["python"]));sys.path.insert(0,str(execution));sys.path.insert(0,str(identity_adapter.parent));sys.path.insert(0,str(outer_repair.parent));sys.path.insert(0,str(marker_adapter.parent));sys.path.insert(0,str(g12_repair.parent))
    wrapper=importlib.import_module(WRAPPER);contract=importlib.import_module(CONTRACT);identity_mod=importlib.import_module(IDENTITY_ADAPTER_NAME[:-3]);outer_mod=importlib.import_module(OUTER_REPAIR_NAME[:-3]);marker_mod=importlib.import_module(MARKER_REPAIR_NAME[:-3]);g12_mod=importlib.import_module(G12_REPAIR_NAME[:-3])
    req=contract.load_json(request,"PHYSICAL_REQUEST_INVALID");req=contract.validate_physical_request(req,execution);wrapper.bind_complete_chain();d2_11=wrapper._bound_d2_11()
    outer=outer_mod.validate_outer_preclaim_without_unbound_configure(d2_11=d2_11,d2_17_contract=contract,authorization_path=auth_path,authorization=auth,request=req,identity=identity,package_root=execution,python_path=targets["python"],openssl_path=targets["openssl"],esptool_path=targets["esptool"],mosquitto_path=targets["mosquitto"],now=datetime.now(timezone.utc),home=Path.home())
    require(outer.get("status")=="PASS" and outer.get("configured_core_called") is False,"OUTER_PRECLAIM_VALIDATION_FAILED")
    d2_11._BOUND_PHYSICAL_REQUEST=req
    first=identity_mod.install_runtime_identity_adapter(d2_11,contract,identity);second=marker_mod.install_runtime_marker_digest_adapter(d2_11,D2_REQUEST_ID)
    require(first.get("installed") and second.get("installed"),"RUNTIME_ADAPTER_INSTALL_FAILED")
    return {"runtime":runtime,"terminal":terminal,"summary":summary,"identity":identity,"authorization":auth,"authorization_path":auth_path,"state_root":state,"execution":execution,"request_path":request,"identity_adapter":identity_adapter,"marker_adapter":marker_adapter,"g12_repair":g12_repair,"g12_mod":g12_mod,"wrapper":wrapper,"contract":contract,"d2_11":d2_11}

def failure(code:str,flags:dict[str,bool])->dict[str,Any]:
    v={"schema":"gh.h3.n2.stage2d9r-g3r-d2-17-g12-physical-decision-terminal/1","status":"BLOCKED_BEFORE_INHERITED_CLAIM","terminal_state":"PHYSICAL_DECISION_PRECLAIM_BLOCKED_UNCLAIMED_UNCONSUMED","failure_code":code,"decision_id":DECISION_ID,"d2_request_id":D2_REQUEST_ID,"authorization_claimed":False,"authorization_consumed":False,"replay_permitted":False,"automatic_retry_permitted":False,"board_operation":flags["board"],"usb_enumeration":flags["usb"],"serial_operation":flags["serial"],"esptool_operation":flags["esptool"],"flash_operation":False,"physical_nvs_operation":flags["nvs"],"network_operation":False,"broker_started":False,"prepare_executed":False,"verify_executed":False,"recovery_executed":False,"activate_executed":False,"cleanup_executed":False,"ready":False,"merge":False,"release":False,"tag":False,"deployment":False};v["terminal_record_sha256"]=canonical(v);return v

def run(decision_root:Path)->int:
    require(sys.platform=="darwin","TARGET_HOST_NOT_DARWIN");decision_root=decision_root.expanduser().resolve(strict=True);verify_sums(decision_root,"PHYSICAL_PACKAGE")
    manifest=load_json(decision_root/"G12_PHYSICAL_OPERATOR_PACKAGE_MANIFEST.json","PHYSICAL_PACKAGE_MANIFEST_INVALID");verify_binding(manifest,"operator_package_binding_sha256",manifest.get("operator_package_binding_sha256"),"PHYSICAL_PACKAGE_MANIFEST")
    require(manifest.get("decision_id")==DECISION_ID and manifest.get("source_pr")==BASE_PR and manifest.get("source_head_sha")==BASE_HEAD,"PHYSICAL_PACKAGE_SOURCE_DRIFT")
    acceptance=decision_root/"artifacts/d2-17-g12-target-mac-static-check-acceptance-8789506567.zip";verify_artifact_zip(acceptance,ACCEPTANCE_ARTIFACT_SHA256,BASE_HEAD,"h3-n2-stage2d9r-g3r-d2-17-g12-target-mac-static-check-pass-20260731-v1.json",{"acceptance_binding_sha256":ACCEPTANCE_BINDING_SHA256,"authorization_record_sha256":AUTHORIZATION_RECORD_SHA256,"terminal_record_sha256":STATIC_TERMINAL_RECORD_SHA256,"configured_runtime_validator_check_sha256":CONFIGURED_VALIDATOR_CHECK_SHA256},"ACCEPTANCE_ARTIFACT")
    decision_art=decision_root/"artifacts/d2-17-g12-physical-execution-decision-review.zip";require(sha(decision_art)==manifest.get("physical_decision_artifact_sha256"),"PHYSICAL_DECISION_ARTIFACT_DIGEST_DRIFT")
