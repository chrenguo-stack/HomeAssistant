 physical=runtime/"D2_17_G14_PHYSICAL_EXECUTION_20260731_01";terminal_path=physical/"D2_17_G14_PHYSICAL_DECISION_TERMINAL.json";result_path=physical/"D2_17_G14_PHYSICAL_RESULT.json";decision_marker=Path.home()/".local/state/greenhouse-stage2d9r/d2-17-g14-physical-decisions"/(DECISION_ID+".json");auth_marker=ctx["state_root"]/AUTH_MARKER_NAME
