 state=runtime/"authorization-state-g14";require(state.is_dir() and not state.is_symlink(),"AUTHORIZATION_STATE_ROOT_INVALID");require((runtime/"G14_AUTHORIZATION_CREATED.json").is_file(),"AUTHORIZATION_CREATION_MARKER_MISSING");require(not (state/AUTH_MARKER_NAME).exists(),"AUTHORIZATION_ALREADY_CLAIMED_OR_CONSUMED")
